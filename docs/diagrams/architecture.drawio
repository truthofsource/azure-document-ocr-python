ounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285" y="1203" /></Array></mxGeometry></mxCell><mxCell id="edge-13" parent="1" source="permission" target="usage" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="1798.0" /><mxPoint x="285.0" y="1798.0" /></Array></mxGeometry></mxCell><mxCell id="edge-14" parent="1" source="usage" target="service" value="API submits once" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-15" parent="1" source="service" target="receipt" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1115.0" y="2036.0" /><mxPoint x="1115.0" y="2036.0" /></Array></mxGeometry></mxCell><mxCell id="edge-16" parent="1" source="receipt" target="validate" value="Completed response" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-17" parent="1" source="validate" target="publish" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285.0" y="2274.0" /><mxPoint x="700.0" y="2274.0" /></Array></mxGeometry></mxCell><mxCell id="edge-18" parent="1" source="permission" target="publish" value="Usable local text: no OCR" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.0;exitY=0.5;entryX=0.0;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="1679" /><mxPoint x="80" y="2393" /></Array></mxGeometry></mxCell><mxCell id="note-0" parent="1" value="Recognized text is stored in Azure SQL for retrieval; the original Blob/PDF is retained unchanged. This does not add a searchable layer to the PDF." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2764" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-1" parent="1" value="A clean upload, approved search policy, completed OCR and published index are separate states. Blank-only content cannot become useful indexed evidence." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2787" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-2" parent="1" value="The saved receipt does not provide automatic post-restart resumption. Uncertain submission or lease state requires review, never a blind second POST." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2810" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-3" parent="1" value="Storage scan queues belong to the existing Defender pipeline; RAG indexing jobs and leases are in SQL. No dedicated OCR worker is deployed." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2833" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-4" parent="1" value="Architecture, not a live health check: native extraction can bypass OCR; independent server/source flags and private service readiness still apply." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2856" width="1292" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
