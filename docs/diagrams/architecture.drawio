<mxfile host="app.diagrams.net" agent="Platform architecture diagram" type="device"><diagram id="azure-document-ocr-python" name="Azure Document OCR — Document Processing Pipeline"><mxGraphModel page="1" pageScale="1" pageWidth="1400" pageHeight="2240" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="heading" parent="1" value="&lt;b&gt;Azure Document OCR — Document Processing Pipeline&lt;/b&gt;" style="text;html=1;align=left;fontFamily=Arial;fontSize=30;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="47" width="1292" height="44" as="geometry" /></mxCell><mxCell id="subtitle" parent="1" value="Approved scans → validated, searchable text for the platform." style="text;html=1;align=left;fontFamily=Arial;fontSize=16;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="94" width="1292" height="30" as="geometry" /></mxCell><mxCell id="eyebrow" parent="1" value="PLATFORM ARCHITECTURE · ILLUSTRATED OVERVIEW" style="text;html=1;align=left;fontFamily=Arial;fontSize=12;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="17" width="1292" height="24" as="geometry" /></mxCell><mxCell id="prerequisites" parent="1" value="&lt;div style=&quot;font-size:16px;line-height:20px;font-weight:bold&quot;&gt;Platform prerequisites&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:18px;margin-top:8px&quot;&gt;Documents UI + Entra staff permissions.&lt;br/&gt;Private Blob + trusted Defender proof.&lt;br/&gt;Managed identity + Hub private paths.&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacingTop=58;spacingBottom=8;spacingLeft=10;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#20384f;fontFamily=Arial;" vertex="1"><mxGeometry x="54" y="166" width="350" height="170" as="geometry" /></mxCell><mxCell id="purpose-icon-prerequisites" parent="prerequisites" value="" vertex="1" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F20