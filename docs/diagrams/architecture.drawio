ry></mxCell><mxCell id="edge-5" parent="1" source="receipt" target="publish" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="1560.0" /><mxPoint x="700.0" y="1560.0" /></Array></mxGeometry></mxCell><mxCell id="edge-6" parent="1" source="publish" target="handoff" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="1798.0" /><mxPoint x="700.0" y="1798.0" /></Array></mxGeometry></mxCell><mxCell id="edge-7" parent="1" source="native" target="admission" value="If needed + permitted" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="846.0" /><mxPoint x="700.0" y="846.0" /></Array></mxGeometry></mxCell><mxCell id="edge-8" parent="1" source="native" target="publish" value="Usable local text: no OCR" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=0.0;exitY=0.5;entryX=0.0;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="727" /><mxPoint x="460" y="1679" /></Array></mxGeometry></mxCell><mxCell id="edge-9" parent="1" source="ocr" target="uncertain" value="Unknown" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-10" parent="1" source="receipt" target="uncertain" value="Unconfirmed receipt / status" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586574;strokeWidth=1.7;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;entryX=0.5;entryY=1.0;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1165" y="1441" /></Array></mxGeometry></mxCell><mxCell id="note-0" parent="1" value="OCR prepares text for search; the original Blob/PDF is retained unchanged. No new searchable-PDF layer is created." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2064" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-1" parent="1" value="Selected-page processing still transfers the whole approved file. Without OCR, only readable local text contributes to indexing." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2087" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-2" parent="1" value="A saved receipt does not automatically resume work after a restart. Preserve uncertain operations; do not submit a second paid POST." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2110" width="1292" height="24" as="geometry" /></mxCell><mxCell id="note-3" parent="1" value="Feature flags, source settings and service readiness control execution. This is a pipeline view, not a live health check." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#526276;" vertex="1"><mxGeometry x="54" y="2133" width="1292" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
